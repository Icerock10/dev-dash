model Job {
  id            String   @id @default(cuid())
  userId        String
  company       String
  title         String
  location      String?
  salaryRange   String?
  tags          String[]
  recruiterName String?
  status        JobStatus  @default(NEW)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]

  @@map("jobs")
}

enum JobStatus {
  NEW
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}
