model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String
  name            String
  title           String?
  location        String?
  jobSearchStatus JobSearchStatus @default(NOT_LOOKING)
  skills          String[]
  github          String?
  linkedin        String?
  portfolio       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  jobs            Job[]

  @@map("users")
}

enum JobSearchStatus {
  OPEN
  PASSIVE
  NOT_LOOKING
}
