model Task {
  id          String   @id @default(cuid())
  jobId       String
  title       String
  description String?
  completed   Boolean  @default(false)
  dueDate     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("tasks")
}
